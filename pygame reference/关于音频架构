  核心数据结构关系

  Mixer
   ├── channels: Vec<Channel>     ← 活跃播放轨道
   ├── master_volume: f32
   ├── groups: HashMap<GroupId, GroupConfig>
   └── callback: PlaybackCallback ← 接入 SDL 音频回调

  Channel
   ├── sound: Arc<SoundData>     ← PCM 数据（多 channel 共享）
   ├── cursor: usize              ← 当前播放位置
   ├── state: ChannelState        ← Playing/Paused/Stopped
   ├── volume: f32                ← 0.0 ~ 1.0
   ├── pan: f32                   ← -1.0(L) ~ 1.0(R)
   ├── loop_start: Option<usize>  ← 循环点
   └── fade: Option<FadeState>    ← 淡入/淡出

  SoundData
   └── frames: Vec<StereoFrame>   ← 解码后的立体声帧

  Mixer 回调核心逻辑（伪代码）

  // SDL 音频线程每帧调用一次这个回调
  fn on_frames(&mut self, output: &mut [StereoFrame]) {
      // 1. 先用静音清空输出缓冲区
      output.fill(StereoFrame::SILENT);

      // 2. 遍历所有 channel
      for channel in &mut self.channels {
          if !channel.is_active() { continue; }

          // 3. 每个 channel 生成自己的帧数据
          let mut buf = [StereoFrame::SILENT; 1024];
          let written = channel.read_frames(&mut buf[..output.len()]);

          // 4. 混音：叠加到输出缓冲区（带音量/pan）
          if channel.volume > 0.0 {
              for (out, src) in output[..written].iter_mut().zip(buf[..written].iter()) {
                  out.left  = (out.left  + src.left  * channel.volume).clamp(-1.0, 1.0);
                  out.right = (out.right + src.right * channel.volume).clamp(-1.0, 1.0);
              }
          }
      }
  }

