Engine
│
├── Core                     # 引擎核心基座（最终调整版）
│   ├── App                  # 应用生命周期、主循环
│   ├── Time                 # 时间、帧率、deltaTime
│   ├── Event                # 输入/窗口/自定义事件系统
│   ├── AssetManager         # 磁盘资源加载（图片/模型/Shader）
│   ├── ResourceManager      # CPU资源管理（Mesh/Material/Texture）
│   └── HandleAllocator      # 全局唯一句柄生成器
│
├── Window                   # 跨平台窗口
│   └── Winit                # 窗口、输入、Surface创建
│
├── Graphics                 # 渲染核心（9层最终版）
│   ├── Layer0: Backend      # 纯WGPU底层封装（无业务逻辑）
│   │   ├── RenderContext    # Instance/Adapter/Device/Queue/Surface
│   │   ├── Resouerce
│   │   │   ├── GpuBuffer        # GPU顶点/索引/Uniform缓冲
│   │   │   ├── GpuTexture       # GPU纹理
│   │   │   ├── GpuSampler       # 采样器
│   │   │   ├── GpuShader        # Shader模块
│   │   │   ├── GpuBindGroupLayout #bindgroup布局
│   │   │   ├── GpuBindGroup     # 绑定组
│   │   │   ├── GpuRenderPipeline# 渲染管线
│   │   │   ├── GpuComputePipeline# 计算管线
│   │   ├── InputLayout
│   │   ├── CommandList       # 命令编码
│   │   ├── RenderTarget      # 渲染目标(封装Texture)
│   │   └── SurfaceFrame      # 交换链(最终渲染目标，渲染到屏幕)
│   │
│   ├── Layer1: Resource     # 纯CPU资源（无任何GPU对象）
│   │   ├── TextureAsset      # CPU纹理数据
│   │   ├── ShaderAsset       # CPU Shader源码
│   │   ├── Material          # CPU材质参数
│   │   ├── Mesh              # CPU顶点/索引数据
│   │   ├── Skeleton          # 骨骼数据
│   │   ├── Animation         # 动画数据
│   │   ├── Model             # 网格+材质组合
│   │   └── Prefab            # 预制体
│   │
│   ├── Layer2: GpuCache      # CPU→GPU同步层（复用Backend对象）
│   │   ├── GpuMesh           # 持有Arc<GpuBuffer>（顶点/索引）
│   │   ├── GpuMaterial       # 持有Arc<GpuBindGroup>
│   │   ├── GpuTextureAsset   # 持有Arc<GpuTexture>
│   │   ├── GpuAnimation      # 动画GPU数据
│   │   └── UploadQueue       # 异步GPU上传队列
│   │
│   ├── Layer3: Scene         # 渲染场景（引用资源，不持有）
│   │   ├── Entity            # 实体ID
│   │   ├── Transform         # 坐标/旋转/缩放
│   │   ├── MeshRenderer      # 网格渲染组件
│   │   ├── Camera            # 相机
│   │   ├── Light             # 光源
│   │   ├── Animator          # 动画控制器
│   │   └── ParticleEmitter   # 粒子发射器
│   │
│   ├── Layer4: Visibility    # 可见性剔除
│   │   ├── FrustumCulling    # 视锥剔除
│   │   ├── DistanceCulling   # 距离剔除
│   │   ├── OcclusionCulling  # 遮挡剔除
│   │   ├── LOD               # 细节层次
│   │   └── HLOD              # 分层细节
│   │
│   ├── Layer5: Submission    # 绘制命令生成（最终增强版）
│   │   ├── VisibilityResult  # 接收可见物体
│   │   ├── RenderQueueBuilder# 构建渲染队列
│   │   ├── Instancing        # 实例化合并
│   │   ├── Batching          # 批量绘制
│   │   ├── Sorting           # 标准化渲染排序
│   │   │   ├── Opaque(前→后)
│   │   │   ├── AlphaTest
│   │   │   ├── Transparent(后→前)
│   │   │   └── Overlay
│   │   └── DrawCommand       # 最终绘制指令
│   │
│   ├── Layer6: Lighting      # 光照系统
│   │   ├── 光源类型（平行/点/聚光/面光源）
│   │   ├── 探针（反射/光照探针）
│   │   ├── IBL               # 基于图像的光照
│   │   ├── GI                # 全局光照
│   │   └── LightBuffer       # 光照数据缓冲
│   │
│   ├── Layer7: Shading       # 着色模型
│   │   ├── Unlit/BlinnPhong/PBR/Toon
│   │   ├── ShaderLayout      # Shader参数布局
│   │   └── MaterialLayout    # 材质参数布局
│   │
│   ├── Layer8: Pipeline      # 渲染器实现
│   │   ├── ForwardRenderer
│   │   ├── DeferredRenderer
│   │   ├── ForwardPlusRenderer
│   │   ├── ClusteredRenderer
│   │   └── Pass（Shadow/GBuffer/Lighting/Skybox/透明/UI）
│   │
│   └── Layer9: RenderGraph   # 渲染调度顶层
│       ├── Pass依赖管理
│       ├── 资源生命周期
│       ├── Pass排序
│       └── 帧调度
│
├── Audio                    # 音频系统
├── Physics                  # 物理系统
├── Scripting                # 脚本系统
│   └── Python               # Python绑定（暴露高层接口）
└── Scene                    # 引擎主场景管理